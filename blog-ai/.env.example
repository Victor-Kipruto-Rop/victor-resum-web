# Blog AI Configuration
# Copy this file to .env and fill in your values

# Claude API (Required for blog generation)
ANTHROPIC_API_KEY=your_claude_api_key_here

# SendGrid Email Service (Required for email notifications)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# GitHub Configuration (Optional, for auto-deploy)
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=Victor-Kipruto-Rop/portfolio

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Blog Settings
BLOG_DOMAIN=https://victorkirpruto.dev
BLOG_LANGUAGE=en-us
BLOG_TIMEZONE=UTC

# Scheduler Settings
ENABLE_SCHEDULER=false
SCHEDULER_LOG_FILE=blog_scheduler.log
